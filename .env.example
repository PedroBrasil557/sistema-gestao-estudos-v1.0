# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública/publishable. Pode aparecer como sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# URL local. Na Vercel, configure com a URL oficial de produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOMENTE NO SERVIDOR e opcional. Necessária apenas para exclusão definitiva da conta.
# Nunca use NEXT_PUBLIC_ neste segredo e nunca envie o arquivo .env.local ao Git.
# SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA_AQUI
